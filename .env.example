# ---- Admin login (REQUIRED) -------------------------------------------------
ADMIN_USERNAME=admin
# Generate with:  npm run hash-password   (paste the whole "scrypt$..." line)
ADMIN_PASSWORD_HASH=
# Random string, 32+ characters. e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ---- GitHub storage (REQUIRED for uploads) ----------------------------------
GITHUB_OWNER=qurishprinting-ship-it
GITHUB_REPO=qurishi-wallpapers
GITHUB_BRANCH=main
# Fine-grained personal access token, ONLY this repository, permission: Contents = Read and write
GITHUB_TOKEN=

# ---- Analytics storage (REQUIRED for persistent analytics) ------------------
# Free Upstash Redis database (Vercel Marketplace > Upstash > Redis) -> REST URL + token
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Optional ---------------------------------------------------------------
# IMAGE_MAX_DIMENSION=1600
# IMAGE_TARGET_KB=50
# SESSION_HOURS=8
